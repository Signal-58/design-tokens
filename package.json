{
  "name": "@signal58/design-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Design tokens from code: OKLCH palettes on a contrast ladder, fluid type and space, type rules, and a Figma plugin that writes them into your file.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "s58-tokens": "./bin/s58-tokens.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "jiti": "2.6.1",
    "utopia-core": "1.6.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "24.11.1",
    "publint": "0.3.25",
    "typescript": "7.0.2"
  }
}
